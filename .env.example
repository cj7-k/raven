# LLM / Embeddings
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Vector store (Chroma is local by default, no key needed)
VECTOR_STORE=chroma          # chroma | faiss | pinecone
PINECONE_API_KEY=
PINECONE_ENV=

# Scraper
CRAWL_DEPTH=3
CRAWL_DOMAIN_WHITELIST=

# Redis cache
REDIS_HOST=localhost
REDIS_PORT=6379

# API
API_HOST=0.0.0.0
API_PORT=8000
